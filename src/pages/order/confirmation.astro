<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Vert Printing order request confirmation." />
    <link rel="canonical" href="https://www.vertprinting.co.za/order/confirmation/" />
    <title>Order Request Received | Vert Printing</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="shop-page cart-page">
    <header class="site-header"><a class="brand" href="/" aria-label="Vert Printing home"><img class="brand-logo" src="/assets/vert_logo_header.png" alt="Vert Printing" width="1255" height="570" /><span><strong>Vert Printing</strong><small>Kloof, Durban</small></span></a><button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span></span><span></span><span></span></button><nav id="site-nav" class="site-nav" aria-label="Main navigation"><a href="/#services">Services</a><a href="/#work">Our Work</a><a href="/#story">About</a><a href="/#quote">Get a Quote</a><a href="/shop/">Shop</a><a class="nav-cart-link" href="/cart/" data-cart-link>Cart <span data-cart-count hidden>0</span></a></nav></header>
    <main>
      <section class="cart-shell shop-container">
        <div class="cart-confirmation">
          <p class="section-kicker">Order received</p>
          <h1>Thanks, your order request has been sent.</h1>
          <p data-order-reference>We will review the details and confirm collection, delivery and payment before production starts.</p>
          <p>A confirmation email should arrive shortly. If it does not, please check your spam folder or contact Vert Printing directly.</p>
          <div class="cart-actions"><a class="button primary" href="/shop/">Continue shopping</a><a class="button secondary dark" href="/">Back to home</a></div>
        </div>
      </section>
    </main>
    <script is:inline src="/script.js?v=order-confirmation-20260825a" type="module"></script>
    <script>
      (() => {
        const target = document.querySelector('[data-order-reference]');
        if (!target) return;
        const params = new URLSearchParams(window.location.search);
        let storedOrder = '';
        try { storedOrder = sessionStorage.getItem('vert-last-order-number') || ''; } catch { storedOrder = ''; }
        const order = params.get('order') || storedOrder;
        const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (character: string) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[character as '&' | '<' | '>' | "'" | '"'] || character));
        if (order) target.innerHTML = `Reference <strong>${escapeHtml(order)}</strong>. We will review the details and confirm collection, delivery and payment before production starts.`;
      })();
    </script>
  </body>
</html>
